@startuml async-compensation
title Asynchronous Saga – Compensation Flow

actor User

box "Transactions Microservice" #LightBlue
participant TransactionController
participant TransactionService
database TransactionsDB
end box

box "Kafka" #LightYellow
queue "transaction.create.request" as TCreate
queue "account.validation.success" as AValid
queue "transaction.failed" as TFailed
queue "account.compensated" as AComp
end box

box "Accounts Microservice" #LightGreen
participant AccountService
database AccountsDB
end box


== User Request ==

User -> TransactionController : POST /api/transactions\n(source, dest, amount)
TransactionController -> TransactionService : createTransaction()

== Create Transaction ==

TransactionService -> TransactionService : generate txnId
TransactionService -> TransactionsDB : INSERT transaction\nstatus=PENDING\nsaga=ACCOUNT_VALIDATION_REQUESTED\nstore source,dest,amount
TransactionsDB --> TransactionService : COMMIT OK
 
== Publish Create Request Event ==

TransactionService -> TCreate : publish TransactionCreateRequestEvent\n(txnId, source, dest, amount)
note right of TCreate
Kafka commit
event available to consumers
end note

TransactionService --> TransactionController : 200 OK (PENDING)
TransactionController --> User : transactionId returned


== Account Service Consumes Create Event ==
TCreate -> AccountService : TransactionCreateRequestEvent
activate AccountService

AccountService -> AccountsDB : SELECT source account
AccountsDB --> AccountService : account A
AccountService -> AccountsDB : SELECT destination account
AccountsDB --> AccountService : account B

AccountService -> AccountService : validate balance >= amount

== Reserve Funds ==

AccountService -> AccountsDB : UPDATE source\nbalance -= amount\nreserved += amount
AccountsDB --> AccountService : COMMIT OK

== Publish Validation Success ==

AccountService -> AValid : publish AccountValidationSuccessEvent
deactivate AccountService


== Transaction Processing Fails ==

AValid -> TransactionService : AccountValidationSuccessEvent
activate TransactionService

TransactionService -> TransactionsDB : SELECT transaction by txnId
TransactionsDB --> TransactionService : transaction found

TransactionService -> TransactionService : fraud/risk/compliance ❌ FAILED

TransactionService -> TransactionsDB : UPDATE status=FAILED\nsaga=COMPENSATION_REQUIRED
TransactionsDB --> TransactionService : COMMIT

== Publish Compensation Event ==

TransactionService -> TFailed : publish TransactionFailedEvent
deactivate TransactionService


== Account Service Compensates Reservation ==

TFailed -> AccountService : TransactionFailedEvent
activate AccountService

AccountService -> AccountsDB : SELECT source account
AccountsDB --> AccountService : account A

== Reverse Reservation ==

AccountService -> AccountsDB : UPDATE source\nbalance += amount\nreserved -= amount
AccountsDB --> AccountService : COMMIT

== Publish Compensation Completed ==

AccountService -> AComp : publish AccountCompensatedEvent
' AccountService -> AComp : publish AccountCompensatedEvent\n(txnId)
deactivate AccountService

@enduml
